#
# Menu Item Tests
#
test [can] :
  menu_item [can] :

    on_load [script] :
      load lib cli

    typename [test] :
      description [string] : menu_item typename is registered
      on_test [script] :
        exists? object menu_item
        assert "expected menu_item typename to be registered"

    short_typename [test] :
      description [string] : menu_item short typename is registered
      on_test [script] :
        exists? object mitem
        assert "expected menu_item short typename (mitem) to be registered"

    messages [test] :
      description [string] : menu_item responds to expected messages
      on_test [script] :
        create test.menu_item.mi as mitem
        check ^^.mi for responds_to? ('unload')
        assert "expected menu_item to respond to unload"

    adds_children_on_create [test] :
      description [string] : menu_item adds default children when created
      on_test [script] :
        create test.menu_item.mi2 as mitem
        check ^^.mi2 for contains?
        assert "expected menu_item to add default children on create"

    default_children [test] :
      description [string] : menu_item default children are shortcut, description, and do
      on_test [script] :
        create test.menu_item.mi3 as mitem
        exists? instance test.menu_item.mi3.shortcut
        assert "expected menu_item to have a shortcut child"

        exists? instance test.menu_item.mi3.description
        assert "expected menu_item to have a description child"

        exists? instance test.menu_item.mi3.do
        assert "expected menu_item to have a do child"
