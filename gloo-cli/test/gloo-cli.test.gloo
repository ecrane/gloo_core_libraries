#
# CLI Tests
#
tests [can] :
  gloo-cli [can] :
    lib_objects [can] :

      on_load [script] :
        load lib cli

      cli_objects [test] :
        description [string] : confirm existence of cli object types
        on_test [script] :
          exists? object colorize
          assert "expected the colorize object exist"

          exists? object confirm
          assert "expected the confirm object exist"

          exists? object menu
          assert "expected the menu object exist"

          exists? object menu_item
          assert "expected the menu item object exist"

          exists? object select
          assert "expected the select object exist"

          exists? object prompt
          assert "expected the prompt object exist"

          exists? object shell
          assert "expected the shell object exist"

          exists? object command
          assert "expected the command object exist"

      run_msgs [test] :
        description [string] : confirm that objects can be run
        on_test [script] :
          create tests.gloo-cli.lib_objects.a as ask
          check ^^.a for responds_to? ('run')
          assert "expected to run a prompt"

          create tests.gloo-cli.lib_objects.c as confirm
          check ^^.c for responds_to? ('run')
          assert "expected to run a confirmation"

      shell_msgs [test] :
        description [string] : confirm that shell and command respond to their messages
        on_test [script] :
          create tests.gloo-cli.lib_objects.s as shell
          check ^^.s for responds_to? ('start')
          assert "expected shell to respond to start"

          check ^^.s for responds_to? ('stop')
          assert "expected shell to respond to stop"

          create tests.gloo-cli.lib_objects.cmd as command
          check ^^.cmd for responds_to? ('register')
          assert "expected command to respond to register"

      colorize_msgs [test] :
        description [string] : confirm that colorize responds to its messages
        on_test [script] :
          create tests.gloo-cli.lib_objects.col as colorize
          check ^^.col for responds_to? ('run')
          assert "expected colorize to respond to run"

      shell_default_children [test] :
        description [string] : confirm that a new shell object has default children
        on_test [script] :
          create tests.gloo-cli.lib_objects.sh as shell
          check ^^.sh for contains?
          assert "expected shell to have default children"

      command_default_children [test] :
        description [string] : confirm that a new command object has default children
        on_test [script] :
          create tests.gloo-cli.lib_objects.cmd2 as command
          check ^^.cmd2 for contains?
          assert "expected command to have default children"
