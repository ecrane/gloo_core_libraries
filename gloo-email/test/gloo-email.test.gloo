#
# Gloo Email Tests
#
tests [can] :
  gloo-email [can] :
    lib_obj_verbs [can] :

      err_msg [string] :

      on_load [script] :
        load lib email

      email_smtp_obj [test] :
        description [string] : The email smtp object exists
        on_test [script] :
          exists? object email_smtp
          assert "email smtp object should exist"

      email_imap_obj [test] :
        description [string] : The email imap object exists
        on_test [script] :
          exists? object email_imap
          assert "email imap object should exist"

      email_msg_obj [test] :
        description [string] : The email msg object exists
        on_test [script] :
          exists? object email
          assert "email msg object should exist"

      #
      # A successful 'send' or 'fetch' needs a real SMTP/IMAP server, so
      # it isn't exercised here (the Ruby tests fake the servers). These
      # tests cover structure and the send errors found before any
      # connection is made.
      #

      send_without_a_message [test] :
        description [string] : email_smtp send with no message is an error; it is false
        expect_errors [bool] : true
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.smtp3 as email_smtp

          tell tests.gloo-email.lib_obj_verbs.smtp3 to send
          refute "expected it to be false with no message to send"

      send_to_nothing [test] :
        description [string] : email send with an email_smtp that doesn't exist is an error; it is false
        expect_errors [bool] : true
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.msg3 as email

          tell tests.gloo-email.lib_obj_verbs.msg3 to send (tests.gloo-email.lib_obj_verbs.no_smtp)
          refute "expected it to be false when the email_smtp doesn't exist"

      send_with_something_else [test] :
        description [string] : email_smtp send with something that isn't an email is an error; it is false
        expect_errors [bool] : true
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.smtp4 as email_smtp
          create tests.gloo-email.lib_obj_verbs.not_email as string

          tell tests.gloo-email.lib_obj_verbs.smtp4 to send (tests.gloo-email.lib_obj_verbs.not_email)
          refute "expected it to be false when the message isn't an email"

      send_without_a_message_error [test] :
        description [string] : email_smtp send with no message reports a missing message
        expect_errors [bool] : true
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.smtp5 as email_smtp

          tell tests.gloo-email.lib_obj_verbs.smtp5 to send
          put error into tests.gloo-email.lib_obj_verbs.err_msg

          eval tests.gloo-email.lib_obj_verbs.err_msg = "Missing the email message! eg. tell smtp5 to send (my.email)"
          assert "expected the missing-message error"

      send_to_nothing_error [test] :
        description [string] : email send with an email_smtp that doesn't exist reports it not found
        expect_errors [bool] : true
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.msg4 as email

          tell tests.gloo-email.lib_obj_verbs.msg4 to send (tests.gloo-email.lib_obj_verbs.no_smtp)
          put error into tests.gloo-email.lib_obj_verbs.err_msg

          eval tests.gloo-email.lib_obj_verbs.err_msg = "Object 'tests.gloo-email.lib_obj_verbs.no_smtp' was not found."
          assert "expected the not-found error"

      send_with_something_else_error [test] :
        description [string] : email_smtp send with something that isn't an email reports it
        expect_errors [bool] : true
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.smtp6 as email_smtp
          create tests.gloo-email.lib_obj_verbs.not_email2 as string

          tell tests.gloo-email.lib_obj_verbs.smtp6 to send (tests.gloo-email.lib_obj_verbs.not_email2)
          put error into tests.gloo-email.lib_obj_verbs.err_msg

          eval tests.gloo-email.lib_obj_verbs.err_msg = "'tests.gloo-email.lib_obj_verbs.not_email2' is not an email message."
          assert "expected the not-an-email error"

      email_smtp_messages [test] :
        description [string] : email_smtp responds to send and unload
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.smtp as email_smtp

          check ^^.smtp for responds_to? ('send')
          assert "expected email_smtp to respond to send"

          check ^^.smtp for responds_to? ('unload')
          assert "expected email_smtp to respond to unload"

      email_smtp_default_children [test] :
        description [string] : email_smtp default children are server, port, username, and password
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.smtp2 as email_smtp

          exists? instance tests.gloo-email.lib_obj_verbs.smtp2.server
          assert "expected email_smtp to have a server child"

          exists? instance tests.gloo-email.lib_obj_verbs.smtp2.port
          assert "expected email_smtp to have a port child"

          exists? instance tests.gloo-email.lib_obj_verbs.smtp2.username
          assert "expected email_smtp to have a username child"

          exists? instance tests.gloo-email.lib_obj_verbs.smtp2.password
          assert "expected email_smtp to have a password child"

      email_imap_messages [test] :
        description [string] : email_imap responds to fetch and unload
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.imap as email_imap

          check ^^.imap for responds_to? ('fetch')
          assert "expected email_imap to respond to fetch"

          check ^^.imap for responds_to? ('unload')
          assert "expected email_imap to respond to unload"

      email_imap_default_children [test] :
        description [string] : email_imap default children include mailbox and messages
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.imap2 as email_imap

          exists? instance tests.gloo-email.lib_obj_verbs.imap2.mailbox
          assert "expected email_imap to have a mailbox child"

          exists? instance tests.gloo-email.lib_obj_verbs.imap2.messages
          assert "expected email_imap to have a messages child"

      email_msg_messages [test] :
        description [string] : email msg responds to send and unload
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.msg as email

          check ^^.msg for responds_to? ('send')
          assert "expected email msg to respond to send"

          check ^^.msg for responds_to? ('unload')
          assert "expected email msg to respond to unload"

      email_msg_default_children [test] :
        description [string] : email msg default children are to, from, subject, and body
        on_test [script] :
          create tests.gloo-email.lib_obj_verbs.msg2 as email

          exists? instance tests.gloo-email.lib_obj_verbs.msg2.to
          assert "expected email msg to have a to child"

          exists? instance tests.gloo-email.lib_obj_verbs.msg2.from
          assert "expected email msg to have a from child"

          exists? instance tests.gloo-email.lib_obj_verbs.msg2.subject
          assert "expected email msg to have a subject child"

          exists? instance tests.gloo-email.lib_obj_verbs.msg2.body
          assert "expected email msg to have a body child"
