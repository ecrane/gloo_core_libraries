#
# mysql tests
#
tests [can] :
  mysql [can] :

    on_load [script] :
      load lib db
      load lib mysql

    mysql_object [test] :
      description [string] : The mysql object exists
      on_test [script] :
        exists? object mysql
        assert "mysql object should exist"

    my_sql_verify [test] :
      description [string] : The mysql object can verify
      on_test [script] :
        create tests.mysql.db as mysql
        check ^^.db for responds_to? ('verify')
        assert 'expected mysql to be able to verify'

        check ^^.db for responds_to? ('unload')
        assert 'expected mysql to be able to unload'

    default_children [test] :
      description [string] : mysql default children are host, database, username, and password
      on_test [script] :
        create tests.mysql.db2 as mysql

        exists? instance tests.mysql.db2.host
        assert "expected mysql to have a host child"

        exists? instance tests.mysql.db2.database
        assert "expected mysql to have a database child"

        exists? instance tests.mysql.db2.username
        assert "expected mysql to have a username child"

        exists? instance tests.mysql.db2.password
        assert "expected mysql to have a password child"
