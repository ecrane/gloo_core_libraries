#
# MdDoc object type tests
#
tests [can] :
  md_doc [can] :

    on_load [script] :
      load lib md

    # Set by on_error, for errors from messages that don't set it.
    err_fired [bool] : false
    on_error [script] :
      put true into ^.err_fired

    typename [test] :
      description [string] : md_doc typename is registered
      on_test [script] :
        exists? object md_doc
        assert "expected md_doc typename to be registered"

    default_children [test] :
      description [string] : md_doc has path, frontmatter, and body children
      on_test [script] :
        create tests.md_doc.doc as md_doc

        exists? instance ^^.doc.path
        assert "expected path child to exist"

        exists? instance ^^.doc.frontmatter
        assert "expected frontmatter child to exist"

        exists? instance ^^.doc.body
        assert "expected body child to exist"

    messages [test] :
      description [string] : md_doc responds to read and write
      on_test [script] :
        create tests.md_doc.doc2 as md_doc

        check ^^.doc2 for responds_to? ('read')
        assert "expected md_doc to respond to read"

        check ^^.doc2 for responds_to? ('write')
        assert "expected md_doc to respond to write"

    read_frontmatter [test] :
      description [string] : read populates frontmatter children from file
      on_test [script] :
        create tests.md_doc.doc3 as md_doc
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/test_doc.md' into ^^.doc3.path
        tell ^^.doc3 to read

        exists? instance ^^.doc3.frontmatter.title
        assert "expected title child to be created"

        eval tests.md_doc.doc3.frontmatter.title = 'Test Document'
        assert "expected title to match file value"

        eval tests.md_doc.doc3.frontmatter.state = 'draft'
        assert "expected state to match file value"

    read_body [test] :
      description [string] : read populates body from file
      on_test [script] :
        create tests.md_doc.doc4 as md_doc
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/test_doc.md' into ^^.doc4.path
        tell ^^.doc4 to read

        check ^^.doc4.body for blank?
        refute "expected body to be populated"

    roundtrip [test] :
      description [string] : write then read preserves frontmatter values
      on_test [script] :
        # Set up a temp file path
        create tests.md_doc.tmp as md_doc
        put '/tmp/gloo_md_doc_test.md' into ^^.tmp.path

        # Populate frontmatter and body manually
        create tests.md_doc.tmp.frontmatter.title as string
        put 'Round Trip Title' into tests.md_doc.tmp.frontmatter.title

        create tests.md_doc.tmp.frontmatter.state as string
        put 'active' into tests.md_doc.tmp.frontmatter.state

        put 'Round trip body text.' into tests.md_doc.tmp.body

        # Write then read back into a fresh object
        tell tests.md_doc.tmp to write

        create tests.md_doc.check as md_doc
        put '/tmp/gloo_md_doc_test.md' into ^^.check.path
        tell ^^.check to read

        eval tests.md_doc.check.frontmatter.title = 'Round Trip Title'
        assert "expected title to survive round trip"

        eval tests.md_doc.check.frontmatter.state = 'active'
        assert "expected state to survive round trip"

        eval tests.md_doc.check.body = 'Round trip body text.'
        assert "expected body to survive round trip"

    read_replaces_frontmatter [test] :
      description [string] : reading a second file drops frontmatter keys from the first
      on_test [script] :
        create tests.md_doc.doc5 as md_doc
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/test_doc.md' into ^^.doc5.path
        tell ^^.doc5 to read
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/other_doc.md' into ^^.doc5.path
        tell ^^.doc5 to read

        exists? instance tests.md_doc.doc5.frontmatter.state
        refute "expected state from the first file to be gone"


    read_puts_true_in_it [test] :
      description [string] : a successful read puts true in it
      on_test [script] :
        create tests.md_doc.doc6 as md_doc
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/test_doc.md' into ^^.doc6.path
        tell ^^.doc6 to read
        assert "expected read to put true in it"

    read_a_date [test] :
      description [string] : a date in the frontmatter reads as text
      on_test [script] :
        create tests.md_doc.doc7 as md_doc
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/dated_doc.md' into ^^.doc7.path
        tell ^^.doc7 to read
        eval tests.md_doc.doc7.frontmatter.date = '2026-10-01'
        assert "expected the date to read as 2026-10-01"

    read_with_no_path_is_an_error [test] :
      description [string] : read with no path is an error and puts false in it
      expect_errors [bool] : true
      on_test [script] :
        create tests.md_doc.doc8 as md_doc
        tell ^^.doc8 to read
        refute "expected read with no path to put false in it"

    read_a_missing_file_is_an_error [test] :
      description [string] : read of a missing file is an error and puts false in it
      expect_errors [bool] : true
      on_test [script] :
        create tests.md_doc.doc9 as md_doc
        put '/tmp/no_such_gloo_md_doc.md' into ^^.doc9.path
        tell ^^.doc9 to read
        refute "expected read of a missing file to put false in it"

    read_invalid_frontmatter_is_an_error [test] :
      description [string] : read of invalid frontmatter YAML is an error and puts false in it
      expect_errors [bool] : true
      on_test [script] :
        create tests.md_doc.doc10 as md_doc
        put '~/dev/gloo_core_libraries/gloo-md/test/fixtures/bad_frontmatter.md' into ^^.doc10.path
        tell ^^.doc10 to read
        refute "expected read of invalid frontmatter to put false in it"

    write_with_no_path_is_an_error [test] :
      description [string] : write with no path is an error
      expect_errors [bool] : true
      on_test [script] :
        put false into ^^.err_fired
        create tests.md_doc.doc11 as md_doc
        tell ^^.doc11 to write
        eval ^^.err_fired = true
        assert "expected write with no path to fire on_error"

    write_failure_is_an_error [test] :
      description [string] : a write that fails (a missing folder) is an error
      expect_errors [bool] : true
      on_test [script] :
        put false into ^^.err_fired
        create tests.md_doc.doc12 as md_doc
        put '/no/such/folder/gloo_md_doc.md' into ^^.doc12.path
        tell ^^.doc12 to write
        eval ^^.err_fired = true
        assert "expected a failed write to fire on_error"

