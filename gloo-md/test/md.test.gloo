#
# Markdown tests
#
load lib md

tests [can] :
  md [can] :

    src [markdown] :
    html [text] :
    note_src_file [file] :
    note_src [markdown] :
    ext_src_file [file] :
    ext_src [markdown] :

    md_object [test] :
      description [string] : The md object exists
      on_test [script] :
        exists? object markdown
        assert "markdown object should exist"

        exists? object md
        assert "md short type should exist"

    md_render [test] :
      description [string] : The md object can render
      on_test [script] :
        create tests.md.md as md
        check ^^.md for responds_to? ('render')
        assert 'expected md to be able to render'

        check ^^.md for responds_to? ('show')
        assert 'expected md to be able to show'

    render_to_html [test] :
      description [string] : render with a destination puts the HTML there and true in it
      on_test [script] :
        # a path inside ( ) params must be absolute, not a ^ ref
        put '# Title' into ^^.src
        tell ^^.src to render ( tests.md.html )
        assert "expected render with a destination to put true in it"

        check ^^.html for substring? ( "<h1>Title</h1>" )
        assert "expected the dst object to hold the rendered HTML"

    render_without_a_destination [test] :
      description [string] : render with no destination puts the HTML in it
      on_test [script] :
        put '# Title' into ^^.src
        tell ^^.src to render
        put it into ^^.html
        check ^^.html for substring? ( "<h1>Title</h1>" )
        assert "expected the rendered HTML to be in it"

    render_to_a_missing_destination [test] :
      description [string] : render to a destination that doesn't exist is an error and puts false in it
      expect_errors [bool] : true
      on_test [script] :
        put '# Title' into ^^.src
        tell ^^.src to render ( tests.md.no_such_object )
        refute "expected render to a missing destination to put false in it"

    render_inline_markdown [test] :
      description [string] : common inline markdown renders
      on_test [script] :
        put 'some **bold** words' into ^^.src
        tell ^^.src to render ( tests.md.html )
        check ^^.html for substring? ( "<strong>bold</strong>" )
        assert "expected bold to render"

    render_note_extension [test] :
      description [string] : a [!NOTE] block renders through the full render pipeline
      on_test [script] :
        # markdown values are single-line, so a real multi-line source
        # with a blank line after the extension block (required for it
        # to render - see markdown_ext_test.rb) comes from a fixture
        # file rather than a literal.
        # The generic [file] type's own read message does not expand
        # '~' the way MdDoc#resolve_path does (it calls File.exist?
        # on the raw value) - a real absolute path is needed here.
        put '/Users/ecrane/dev/gloo_core_libraries/gloo-md/test/fixtures/note_extension.md' into ^^.note_src_file
        tell ^^.note_src_file to read ( tests.md.note_src )

        tell ^^.note_src to render ( tests.md.html )

        check ^^.html for substring? ( "gloo-panel-secondary" )
        assert "expected the note block to render as a secondary panel"

        check ^^.html for substring? ( "Heads up" )
        assert "expected the note title to appear in the rendered HTML"

        check ^^.html for substring? ( "Before." )
        assert "expected markdown before the extension block to still render"

        check ^^.html for substring? ( "After." )
        assert "expected markdown after the extension block to still render"

    unknown_extension_is_kept [test] :
      description [string] : an unknown extension is kept as plain text, with a warning
      expect_errors [bool] : true
      on_test [script] :
        put '/Users/ecrane/dev/gloo_core_libraries/gloo-md/test/fixtures/unknown_extension.md' into ^^.ext_src_file
        tell ^^.ext_src_file to read ( tests.md.ext_src )
        tell ^^.ext_src to render ( tests.md.html )

        check ^^.html for substring? ( "Kept content." )
        assert "expected the unknown extension's content to be kept"

    extension_at_the_end_renders [test] :
      description [string] : an extension block that ends the text, with no blank line after it, still renders
      on_test [script] :
        put '/Users/ecrane/dev/gloo_core_libraries/gloo-md/test/fixtures/trailing_note.md' into ^^.ext_src_file
        tell ^^.ext_src_file to read ( tests.md.ext_src )
        tell ^^.ext_src to render ( tests.md.html )

        check ^^.html for substring? ( "The last thing in the file." )
        assert "expected the final note block to render"

