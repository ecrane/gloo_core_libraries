#
# sqlite tests
#
load lib db
load lib sqlite

tests [can] :
  sqlite [can] :

    # a scratch db under /tmp, created by the first query and removed
    # at the end of the round-trip test
    conn [sqlite] :
      database : /tmp/gloo_sqlite_test.db

    dbfile [file] : /tmp/gloo_sqlite_test.db

    make [query] :
      database [alias] : tests.sqlite.conn
      sql : CREATE TABLE IF NOT EXISTS t ( id INTEGER PRIMARY KEY, name TEXT )

    wipe [query] :
      database [alias] : tests.sqlite.conn
      sql : DELETE FROM t

    add [query] :
      database [alias] : tests.sqlite.conn
      sql : INSERT INTO t ( name ) VALUES ( ? )
      params [can] :
        name :

    fetch [query] :
      database [alias] : tests.sqlite.conn
      sql : SELECT id, name FROM t ORDER BY id
      result [can] :

    # a single-row select whose result columns are aliases pointing
    # elsewhere - the update path that needs the engine to resolve them
    found_name [string] :
    fetch_one [query] :
      database [alias] : tests.sqlite.conn
      sql : SELECT name FROM t ORDER BY id LIMIT 1
      result [can] :
        name [alias] : tests.sqlite.found_name

    sqlite_object [test] :
      description [string] : The sqlite object exists
      on_test [script] :
        exists? object sqlite
        assert "sqlite object should exist"

    verify_msg [test] :
      description [string] : The sqlite object can verify
      on_test [script] :
        create tests.sqlite.db as sqlite
        check ^^.db for responds_to? ('verify')
        assert 'expected sqlite to be able to verify'

    query_round_trip [test] :
      description [string] : create a table, insert rows, and select them back into a result container
      on_test [script] :
        run tests.sqlite.make
        run tests.sqlite.wipe

        put 'alpha' into tests.sqlite.add.params.name
        run tests.sqlite.add
        put 'beta' into tests.sqlite.add.params.name
        run tests.sqlite.add

        run tests.sqlite.fetch

        tell tests.sqlite.fetch.result to count
        eval it = 2
        assert "expected two rows back from the select"

        eval tests.sqlite.fetch.result.0.name = 'alpha'
        assert "expected the first row's name column"

        eval tests.sqlite.fetch.result.1.name = 'beta'
        assert "expected the second row's name column"

        tell tests.sqlite.dbfile to delete

    single_row_alias_result [test] :
      description [string] : a single-row select maps onto alias children in the result container
      on_test [script] :
        run tests.sqlite.make
        run tests.sqlite.wipe
        put 'solo' into tests.sqlite.add.params.name
        run tests.sqlite.add

        put '' into tests.sqlite.found_name
        run tests.sqlite.fetch_one

        eval tests.sqlite.found_name = 'solo'
        assert "expected the aliased result column to be filled in"

        tell tests.sqlite.dbfile to delete
